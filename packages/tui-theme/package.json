{
  "name": "@neurosquad/tui-theme",
  "version": "0.0.0",
  "description": "The NeuroSquad look for terminal UIs: palette with colour-depth downgrade, status glyphs, borders, the >S wordmark, harness logos (kitty / iTerm2 / sixel or glyphs) and frame-based animations.",
  "license": "MIT",
  "author": "NeuroSquad",
  "homepage": "https://neurosquad.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glmn-ai/neurosquad-cli.git",
    "directory": "packages/tui-theme"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/preview.*",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "preview": "tsc -b && node dist/preview.js",
    "test": "vitest run --root ../.. packages/tui-theme"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@xterm/headless": "^6.0.0"
  }
}
