{
  "name": "neurosquad-cli-monorepo",
  "private": true,
  "description": "nsq — a terminal supervisor for AI coding agents (Claude Code, Codex, OpenCode and any command).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "clean": "tsc -b --clean packages/core packages/dictation packages/notify packages/tui-theme packages/term-view packages/remote",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release:smoke": "node scripts/release/pack-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "uiohook-napi@1.5.5": true
  }
}
